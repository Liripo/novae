# Redis backend for the AgentScope agent service
NOVAE_REDIS_HOST=localhost
NOVAE_REDIS_PORT=6379
NOVAE_REDIS_DB=0
NOVAE_REDIS_PASSWORD=

# JWT auth (change the secret in production)
NOVAE_JWT_SECRET=novae-dev-jwt-secret-change-me-in-production
NOVAE_JWT_EXPIRE_HOURS=168

# Root directory under which per-agent workspaces are created
NOVAE_WORKSPACE_ROOT=./data/workspaces

# --- script-only model config (scripts/run_agent.py) ---
# The Web UI manages its own model credentials in Redis; these are only
# used by scripts/run_agent.py to build a standalone Agent instance.
OPENAI_API_KEY=
OPENAI_BASE_URL=
NOVAE_MODEL=

# --- chat-model retry policy (rate-limit friendly) ---
# Free-tier models answer HTTP 429 often; the backend retries the model
# call up to NOVAE_MODEL_MAX_RETRIES extra times, waiting
# NOVAE_MODEL_RETRY_DELAY seconds between attempts. Raise these when the
# chat log shows "Attempt N failed ... Rate limit exceeded" frequently.
NOVAE_MODEL_MAX_RETRIES=5
NOVAE_MODEL_RETRY_DELAY=3
