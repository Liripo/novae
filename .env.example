# ========== Redis 配置 ==========
NOVAE_REDIS_HOST=localhost
NOVAE_REDIS_PORT=6379
NOVAE_REDIS_DB=0
NOVAE_REDIS_PASSWORD=

# ========== JWT 认证 ==========
# 生产环境请务必修改密钥
NOVAE_JWT_SECRET=novae-dev-jwt-secret-change-me-in-production
NOVAE_JWT_EXPIRE_HOURS=168

# ========== 模型配置 ==========
# API 密钥和基础 URL（兼容 OpenAI 格式）
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 使用的模型名称
NOVAE_MODEL=

# 重试策略（应对免费模型限流）
NOVAE_MODEL_MAX_RETRIES=5
NOVAE_MODEL_RETRY_DELAY=3

# ========== MCP 服务器 ==========
# 默认内置 paper-search 和 biomcp，无需额外配置
# 如需自定义，可设置为 JSON 数组，例如：
# NOVAE_MCP_SERVERS=[{"name":"zotero","url":"http://localhost:3001/sse"}]
# NOVAE_MCP_SERVERS=[]  # 禁用所有 MCP
